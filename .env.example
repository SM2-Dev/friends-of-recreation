DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/friends_of_recreation
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel preview / production. Neon sets POSTGRES_URL; connecting a Blob store sets BLOB_READ_WRITE_TOKEN.
# Image uploads on Vercel require BLOB_READ_WRITE_TOKEN — without it Payload tries local disk and fails.
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
# PAYLOAD_PUSH_SCHEMA=true
# SITE_NOINDEX=true

# Contact and grant notification email. Submissions are stored in Payload even when this is unset.
# When RESEND_API_KEY and NOTIFICATION_FROM are set, staff receive a copy of each submission.
# NOTIFICATION_FROM=
# RESEND_API_KEY=

# Cloudflare Turnstile. Leave unset until keys are issued. Forms still use a honeypot in that case.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
