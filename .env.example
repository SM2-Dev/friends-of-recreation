DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/friends_of_recreation
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional production object storage for Media. When unset, files stay on local disk.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Contact and grant notification email. Submissions are stored in Payload even when this is unset.
# Do not treat a saved form as a delivered email until a provider is wired in src/lib/notify.ts.
# NOTIFICATION_FROM=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Cloudflare Turnstile. Leave unset until keys are issued. The contact form still saves submissions.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
